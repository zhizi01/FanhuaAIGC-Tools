{
  "name": "qingshan-ai-comic",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "青山AI漫剧工具",
  "author": "青山",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "node electron/dev.js",
    "build:win": "vite build && electron-builder --dir"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.18.1",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.0"
  },
  "build": {
    "appId": "com.qingshan.aicomic",
    "productName": "青山AI漫剧工具",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "dir"
    }
  }
}
